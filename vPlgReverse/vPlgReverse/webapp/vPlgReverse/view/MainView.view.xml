<mvc:View xmlns:mvc="sap.ui.core.mvc" 
          xmlns="sap.m" 
          xmlns:l="sap.ui.layout" 
          xmlns:f="sap.ui.layout.form" 
          xmlns:core="sap.ui.core" 
          xmlns:html="http://www.w3.org/1999/xhtml" 
          controllerName="ibc.dm.vPlgReverse.vPlgReverse.controller.MainView" 
          width="100%" height="100%">
        <Panel 
                id="panelPlugin"  
                width="100%"
                height="100%"
                expandable="true"
                expanded="true"
                accessibleRole="Region"
                backgroundDesign="Transparent"
                class="sapUiSmallContentPadding">  
            <content> 
                <Table id="stornoTable"   items="{ path: 'stornoModel>/items',
                                                   factory: '.createRow' }" inset="false">
                <columns>
                    <Column>
                        <Text text="Data/godzina" />
                    </Column>
                    <Column>
                        <header>
                            <VBox>
                              <Label design="Bold"  text="Potwierdzenie produkcji" wrapping="true" />
                              <Label design="Standard"  text="(Materiał / Nośnik / Ilość)" wrapping="true" />
                            </VBox>
                        </header>
                    </Column>
                    <Column>
                        <header>
                            <VBox>
                              <Label design="Bold"  text="Wydanie" wrapping="true" />
                              <Label design="Standard"  text="(Materiał / Nośnik / Ilość)" wrapping="true" />
                            </VBox>
                        </header>
                    </Column>
                    <Column>
                        <Text text="Użytkownik" />
                    </Column>
                    <Column>
                        <Text text="" />
                    </Column>
                </columns>

                </Table>
            </content>
	    </Panel>		
        
  
</mvc:View>