<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core" xmlns:html="http://www.w3.org/1999/xhtml" controllerName="ibc.dm.vPlgReceiptSfcQ23.vPlgReceiptSfcQ23.controller.MainView" width="100%" height="100%">
		
    <Panel 
        id="panelPlugin"  
        width="100%"
        height="100%"
        expandable="false"
        expanded="false"
        accessibleRole="Region"
        backgroundDesign="Transparent"
        class="sapUiNoContentPadding">  

        <VBox alignItems="Center" justifyContent="Center" class="sapUiLargeMarginBegin sapUiLargeMarginEnd">
            <Table items="{ path: '/items' }"
                    inset="false"
                    fixedLayout="true"
                    class="sapUiLargeMarginBottom">
                <columns>
                    <Column width="50rem">
                        <Text id="CodeDescriptionColumn"/>
                    </Column>
                    <Column width="5rem">
                        <Text id="QuantityConformanceColumn"  visible = "true" text="{i18n>postedNc}"/>
                    </Column>
                    <Column width="20rem">
                        <HBox>
                            <Input id="totalQ23" value="{i18n>totalNc}: {/totalNcQuantity}" editable="false" width="10rem" class="inputFontQ23" textAlign="Center"/>
                            <Input id="availableQ23" value="Dostępne: 0" editable="false" width="13rem" class="inputFontQ23" textAlign="Center"/>
                        </HBox>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle" >
                        <cells>
                            <Text text="{codeDescription}" width="50rem" class="fontTextQ23"/>
                            <Input value="{conconformanceQuantity}" editable="false" width="5rem" class="inputFontQ23" textAlign="Center"/>
                            <HBox>
                                <Input value="{quantity}" editable="true" width="10rem" class="inputFontQ23 sapUiSmallMarginEnd" textAlign="Center"/>
                                <Button icon="sap-icon://accept" id="wasteButton" press="onWasteButton" class="bigButtonQ23 bigButtonIcon sapUiSmallMarginEnd" width="6rem"/>
                                <Button icon="sap-icon://image-viewer" id="imageButton" press="onImageButton" class="bigButtonQ23 bigButtonIcon sapUiSmallMarginEnd" width="6rem" visible="{/q3ImageVisible}"/>
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
	</Panel>		
        
  
</mvc:View>