<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core" xmlns:html="http://www.w3.org/1999/xhtml" controllerName="ibc.dm.vPlgReceiptSfcQ23.vPlgReceiptSfcQ23.controller.MainView" width="100%" height="100%">
		
    <Panel 
        id="panelPlugin"  
        width="100%"
        height="100%"
        expandable="false"
        expanded="false"
        accessibleRole="Region"
        backgroundDesign="Transparent"
        class="sapUiNoContentPadding">  

        <VBox alignItems="Center" justifyContent="Center" class="sapUiLargeMarginBegin sapUiLargeMarginEnd">
            <Table items="{ path: '/items' }"
                    inset="false"
                    fixedLayout="true"
                    class="sapUiLargeMarginBottom">
                <columns>
                    <Column width="50rem">
                        <Text id="CodeDescriptionColumn"/>
                    </Column>
                    <Column width="5rem">
                        <Text id="QuantityConformanceColumn"  visible = "true" text="Zgłoszone"/>
                    </Column>
                    <Column width="10rem">
                        <Text id="QuantityColumn"  visible = "true"/>
                    </Column>
                    <Column width="12rem">
                        <Text id="ButtonCol"  />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle" >
                        <cells>
                            <Text text="{codeDescription}" width="50rem" class="fontTextQ23"/>
                            <Input value="{conconformanceQuantity}" editable="false" width="5rem" class="inputFont" textAlign="Center"/>
                            <Input value="{quantity}" editable="true" width="10rem" class="inputFont" textAlign="Center"/>
                            <Button icon="sap-icon://accept" id="wasteButton" press="onWasteButton" class="bigButtonQ23 bigButtonIcon sapUiSmallMarginEnd" width="6rem"/>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </VBox>
	</Panel>		
        
  
</mvc:View>