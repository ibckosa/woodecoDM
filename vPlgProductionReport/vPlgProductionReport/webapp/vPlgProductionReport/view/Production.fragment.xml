<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:ct="sap.suite.ui.microchart"
  xmlns:core="sap.ui.core">
  <Table id="componentsTable"   items="{path:'/productionItems'}" inset="false">
    <columns>
      <Column width="5%">
        <Text text="{i18n>productionDate}" />
      </Column>
      <Column width="5%">
        <Text text="{i18n>shift}" />
      </Column>
      <Column width="5%">
        <Text text="{i18n>productionOrder}" />
      </Column>
      <Column width="5%">
        <Text text="{i18n>itemNO}" />
      </Column>
      <Column width="15%">
        <Text text="{i18n>material}" />
      </Column>
      <Column width="7%">
        <Text text="{i18n>numberOfQ1}" />
      </Column>
      <Column width="30%">
        <Text text="{i18n>numberOfQ23}" />
      </Column>
      <Column width="auto">
        <Text text="KPI Q1" />
      </Column>
      <Column width="auto">
        <Text text="KPI M2/M3" />
      </Column>
    </columns>
    <items>
      <ColumnListItem vAlign="Middle">
        <cells>
          <Text text="{productionDate}" />
          <Text text="{shift}" />
          <Text text="{orderNumber}" />
          <Text text="{itemNumber}" />
          <Text text="{material}" />
          <Text text="{q1Quantity}" />
          <FormattedText htmlText="{q23Quantity}" />

          <VBox visible="{isQ1PercentageIndicatorVisible}">
              <ObjectStatus
                  class="bigObjectStatus"
                  text="{q1Percentage}%"
                  state="{= ${q1Percentage} >= ${q1PercentagePlan} ? 'Success' : 'Error' }" />

              <ObjectStatus
                  text="{i18n>target} {q1PercentagePlan}"
                  state="{= ${q1Percentage} >= ${q1PercentagePlan} ? 'Success' : 'Error' }"/>
          </VBox>
          
          <VBox visible="{isPlanIndicatorVisible}">
              <ObjectStatus
                  class="bigObjectStatus"
                  text="{planForRow}{planUOM}"
                  state="{= ${planForRow} >= ${planExecution} ? 'Success' : 'Error' }" />

              <ObjectStatus
                  text="{i18n>target} {q1PercentagePlan}"
                  state="{= ${planForRow} >= ${planExecution} ? 'Success' : 'Error' }"/>
          </VBox>
        </cells>
    </ColumnListItem>
    </items>
  </Table>
</core:FragmentDefinition>