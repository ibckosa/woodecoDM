<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:l="sap.ui.layout"
  xmlns:core="sap.ui.core">
		<l:VerticalLayout
				width="100%">
			<l:Grid	>
				<VBox class= "sapUiTinyMarginTop">
					<Label text="{i18n>date}" labelFor="datePicker" />
					<DatePicker id="datePicker"
								displayFormat="yyyy-MM-dd" />
					<layoutData>
						<l:GridData span="XL2 L2 M2 S12" />
					</layoutData>
				</VBox>

				<VBox class= "sapUiTinyMarginTop">
					<Label text="{i18n>shift}:" labelFor="shiftCb" />
					<ComboBox
						id="shiftCb"
						selectedKey="">
						<items>
							<core:Item key="" text="{i18n>allShifts}" />
							<core:Item key="1" text="1" />
							<core:Item key="2" text="2" />
							<core:Item key="3" text="3" />
							<core:Item key="onlyDay" text=" " />
						</items>

					</ComboBox>
					<layoutData>
						<l:GridData span="XL1 L1 M1 S12" />
					</layoutData>
				</VBox>

				<VBox class= "sapUiTinyMarginTop">
					<Label text="{i18n>productionOrder}:" labelFor="orderNumber" />
					<Input id="orderNumber" type="Text"/>
					<layoutData>
						<l:GridData span="XL2 L2 M2 S12" />
					</layoutData>
				</VBox>

				<VBox class= "sapUiTinyMarginTop">
					<Label text="{i18n>aggregate}" labelFor="aggregationFilter" />
					<SegmentedButton id="aggregationFilter" selectedKey="yes" class="sapUiSmallMarginBottom" selectionChange="onAggregationChange">
						<items>
							<SegmentedButtonItem text="{i18n>yes}" key="yes" />
							<SegmentedButtonItem text="{i18n>no}" key="no" />
						</items>
					</SegmentedButton>
					<layoutData>
						<l:GridData span="XL1 L1 M1 S12" />
					</layoutData>
				</VBox>

				<VBox class= "sapUiTinyMarginTop">
					<Text ></Text>	
					<SearchField id="searchField" placeholder="{i18n>search}" search="onSearch"/>
					<layoutData>
						<l:GridData span="XL3 L3 M3 S12" />
					</layoutData>
				</VBox>



				<VBox class= "sapUiTinyMarginTop">
					<Text ></Text>	
					<Button text="Start" type="Emphasized" press="onStart"/>
					<layoutData>
						<l:GridData span="XL1 L1 M1 S12" />
					</layoutData>
				</VBox>
			</l:Grid>
		</l:VerticalLayout>
</core:FragmentDefinition>