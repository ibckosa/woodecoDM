<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:ct="sap.suite.ui.microchart"
  xmlns:unified="sap.ui.unified">


        <VBox visible="{isQ1PercentageIndicatorVisible}">
			<ObjectStatus
				class="bigObjectStatus"
				text="UPTIME: {/availabilityPercentage}%"
				state="{= ${/availabilityPercentage} >= ${/targetPercentage} ? 'Success' : 'Error' }" />

			<ObjectStatus
				text="{i18n>target} {/targetPercentage}"
				state="{= ${/availabilityPercentage} >= ${/targetPercentage} ? 'Success' : 'Error' }"/>
        </VBox>

		<PlanningCalendar
			id="PC1"
			viewKey="A"
			legend="PCLegend"
			class="hideButton"
			appointmentsVisualization="Filled"
			appointmentSelect="handleDTSelect"
			rows="{path: '/downtimesCalendarItems'}">
			<views>
				<PlanningCalendarView
					key="A"
					
					intervalType="Hour"
					description=""
					intervalsS="24"
					intervalsM="24"
					intervalsL="24">
				</PlanningCalendarView>
				<PlanningCalendarView
					key="B"
					intervalType="Hour"
					description=""
					intervalsS="8"
					intervalsM="8"
					intervalsL="8">
				</PlanningCalendarView>
			</views>

			<rows>
				<PlanningCalendarRow
					icon="{pic}"
					title="{name}"
					text="{role}"
					appointments="{path : 'items', templateShareable: false}"
					intervalHeaders="{path: 'headers', templateShareable: false}">
					<customData>
						<core:CustomData key="emp-name" value="{name}" writeToDom="true"/>
					</customData>
					<appointments>
						<unified:CalendarAppointment
							startDate="{start}"
							endDate="{end}"
							icon="{pic}"
							title="{categoryDescription}"
							text="{info}"
							color="{color}"
							tentative="{tentative}">
						</unified:CalendarAppointment>
					</appointments>
                    <intervalHeaders>
                        <unified:CalendarAppointment
                            startDate="{start}"
                            endDate="{end}"
                            icon="{pic}"
                            title="{categoryDescription}"
                            color="{color}">
                        </unified:CalendarAppointment>
                    </intervalHeaders>
				</PlanningCalendarRow>
			</rows>
		</PlanningCalendar>

<HBox>
	<Table id="dtCategoryTable" class="sapUiTinyMarginTop sapUiSmallMarginLeft" width="40%" items="{path:'/downTimesCategories'}" inset="false">
		<columns>
			<Column>
				<Text text="{i18n>category}" />
			</Column>
			<Column>
				<Text text="{i18n>numberOfMinutes}" />
			</Column>
		</columns>
		<items>
			<ColumnListItem vAlign="Middle">
				<cells>
					<HBox alignItems="Center">
						<core:HTML content="{       parts: [ { path: 'categoryName' }, { path: 'color' } ], formatter: '.formatLegendBox'}" />
						<FormattedText htmlText="{categoryDescription}" />
					</HBox>
					<FormattedText htmlText="{value}" />
				</cells>
			</ColumnListItem>
		</items>
	</Table>
</HBox>
</core:FragmentDefinition>