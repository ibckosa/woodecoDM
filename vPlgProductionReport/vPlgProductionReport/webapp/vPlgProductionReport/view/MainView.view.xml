<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:l="sap.ui.layout" xmlns:f="sap.ui.layout.form" xmlns:core="sap.ui.core" xmlns:html="http://www.w3.org/1999/xhtml" controllerName="ibc.dm.plugins.vPlgProductionReport.vPlgProductionReport.controller.MainView" width="100%" height="100%">	
    <Panel
        width="100%"
        height="100%"
        expandable="false"
        expanded="false"
        accessibleRole="Region"
        backgroundDesign="Transparent" >  
        <headerToolbar>
            <Toolbar height='5rem'>
                <core:Fragment fragmentName="ibc.dm.plugins.vPlgProductionReport.vPlgProductionReport.view.FilterBar" type="XML"/>
            </Toolbar>
        </headerToolbar>
            <IconTabBar
                id="reportTabBar"
                expanded="{device>/isNoPhone}"
                class="sapUiSmallMarginTop sapUiResponsiveContentPadding">
                <items>
                    <IconTabFilter 
                        icon="sap-icon://cart" 
                        text="{i18n>productionIcon}" key="production">
                        <core:Fragment fragmentName="ibc.dm.plugins.vPlgProductionReport.vPlgProductionReport.view.Production" type="XML"/>
                    </IconTabFilter>
                    <IconTabFilter
                        icon="sap-icon://pause"
                        text="{i18n>downtimesIcon}"
                        key="downtimes">
                        <core:Fragment fragmentName="ibc.dm.plugins.vPlgProductionReport.vPlgProductionReport.view.Downtimes" type="XML"/>
                    </IconTabFilter>
                </items>
            </IconTabBar>
	</Panel>		
</mvc:View>