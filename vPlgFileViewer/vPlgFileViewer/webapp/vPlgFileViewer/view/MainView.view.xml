<mvc:View xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" controllerName="ibc.dm.plugins.vPlgFileViewer.vPlgFileViewer.controller.MainView">
    <Page title="File Viewer">
        <content>
            <Table id="fileTable" inset="false" items="{/files}">
                <columns>
                    <!-- Kolumna File Name -->
                    <Column>
                        <Text text="File Name" />
                    </Column>
                    <!-- Kolumna File Description -->
                    <Column>
                        <Text text="File Description" />
                    </Column>
                    <!-- Kolumna z przyciskiem -->
                    <Column>
                        <Text text="Action" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <!-- Wyświetlanie nazwy pliku -->
                        <cells>
                            <Text text="{fileName}" />
                            <!-- Wyświetlanie opisu pliku -->
                            <Text text="{fileDescription}" />
                            <!-- Przycisk otwierający link -->
                            <Button text="Open Link" press="onOpenLink" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>
