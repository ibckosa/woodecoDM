<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:l="sap.ui.layout"
  xmlns:f="sap.ui.layout.form"
  xmlns:core="sap.ui.core"
  xmlns:html="http://www.w3.org/1999/xhtml"
  controllerName="ibc.dm.plugins.vPlgFileViewer.vPlgFileViewer.controller.MainView"
  width="100%" height="100%">

  <VBox class="sapUiSmallMargin">
    <Table id="linkTable" items="{linkModel>/links}" inset="false">
      <columns>
        <Column visible="false">
          <Text text="Nazwa pliku" />
        </Column>
        <Column>
          <Text text="Opis pliku" />
        </Column>
        <Column>
          <Text text="Wyświetl plik" />
        </Column>
      </columns>
      <items>
        <ColumnListItem>
          <cells>
            <Text text="{linkModel>fileName}" />
            <Text text="{linkModel>fileDescription}" />
            <Button text="Wyswietl plik" press=".onOpenLink" />
          </cells>
        </ColumnListItem>
      </items>
    </Table>
  </VBox>

</mvc:View>
