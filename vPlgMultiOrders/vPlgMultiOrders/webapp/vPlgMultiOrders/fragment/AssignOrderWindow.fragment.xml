<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Dialog
        id="OADialog"
        title="{i18n>OAFragmentTitle}"
        draggable="true"
        resizable="true"
        contentWidth="30rem"
        contentHeight="20rem">
        <VBox class="sapUiSmallMargin">
            <Label  text="{i18n>OAOrderNumber}"
                    labelFor="orderInput"/>
            <Input  id="orderInput"/>
            <Label text="{i18n>OAOrderDate}" />
            <DatePicker id="orderInputDate"
                displayFormat="yyyy-MM-dd"
                valueFormat="yyyy-MM-dd"
                 />
        </VBox>
        <beginButton>
            <Button
                text="OK"
                press=".onOkOADialog"
            />
        </beginButton>
        <endButton>
            <Button
                text="Anuluj"
                press=".onCloseOADialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>